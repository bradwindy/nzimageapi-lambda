# DigitalNZ API Configuration
# Get your API key from: https://digitalnz.org/

DIGITALNZ_API_KEY=your_api_key_here

# Lambda Configuration
# Comma-separated "name:secret" pairs, one per approved consumer (see docs/ACCESS-CONTROL.md).
# The value below matches the local dev tooling's hardcoded header -- keep it as-is for local dev.
API_CLIENT_SECRETS=dev:super_secret_secret
LOCAL_LAMBDA_SERVER_ENABLED=true

# JP2/TIFF converter signing key (shared with the Jp2ConverterFunction Lambda).
# Generate with: openssl rand -hex 32
CONVERTER_SIGNING_KEY=your_converter_signing_key_here
