# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.

# Sent to DigitalNZ as the Authentication-Token header. Get one at https://digitalnz.org/
DIGITALNZ_API_KEY=your_api_key_here

# Comma-separated name:secret pairs, one per consumer (see ../docs/ACCESS-CONTROL.md).
# Clients send the secret in the `secret` header.
API_CLIENT_SECRETS=dev:super_secret_secret

# HMAC key shared with the converter Lambda. Generate with: openssl rand -hex 32
CONVERTER_SIGNING_KEY=your_converter_signing_key_here
